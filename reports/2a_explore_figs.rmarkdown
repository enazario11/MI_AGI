# MI-AGI comparisons

::: panel-tabset
## Atlantic cod

```{r}
#| warning: false
#| message: false
#| label: mi agi cod
#| echo: false
#| out-width: 100%
#| results: hide

agi_cod <- AGI(sp_name = "Atlantic cod", enviro = "bottom")
agi_crit_cod <- get_crit(agi_cod, "bottom")
mi_cod <- MI(sp_name = "Atlantic cod", enviro = "bottom", A0 = 6.68E-07, E0 = 0.42, region = "nwa")
mi_crit_cod <- raster::clamp(mi_cod, upper = 2.74, values = FALSE)
mi_crit_cod <- as.polygons(mi_crit_cod) %>% mutate(lyr = names(mi_cod))

ggplot() +
  geom_spatraster(data = agi_cod) +
  geom_spatvector(data = agi_crit_cod, color = "black", fill = NA, linewidth = 1) +
  geom_sf(data = land, fill = "grey85", colour = "grey30", linewidth = 0.2) +
  coord_sf(xlim = as.vector(ext(agi_cod))[1:2] + c(-2, 2),
           ylim = as.vector(ext(agi_cod))[3:4] + c(-2, 2),
           expand = FALSE) +
  scale_fill_whitebox_c(palette = "muted", direction = -1) +
  labs(x = NULL, y = NULL, fill = "AGI") +
  tidyquant::theme_tq() + 
  facet_wrap(~factor(lyr, levels = names(agi_cod)), labeller = label_wrap_gen(width = 25)) +
  theme_custom()

ggplot() +
  geom_spatraster(data = mi_cod) +
  geom_spatvector(data = mi_crit_cod, color = "black", fill = NA, linewidth = 1) +
  geom_sf(data = land, fill = "grey85", colour = "grey30", linewidth = 0.2) +
  coord_sf(xlim = as.vector(ext(mi_cod))[1:2] + c(-2, 2),
           ylim = as.vector(ext(mi_cod))[3:4] + c(-2, 2),
           expand = FALSE) +
  scale_fill_whitebox_c(palette = "muted", direction = -1) +
  labs(x = NULL, y = NULL, fill = "MI") +
  tidyquant::theme_tq() + 
  facet_wrap(~factor(lyr, levels = names(mi_cod)), labeller = label_wrap_gen(width = 25)) +
  theme_custom()

#run glm to see rship between indices
agi_cod_df <- as.data.frame(agi_cod, xy = TRUE)
colnames(agi_cod_df) <- c("lon", "lat", "agi")
mi_cod_df <- as.data.frame(mi_cod, xy = TRUE)
colnames(mi_cod_df) <- c("lon", "lat", "mi")

cod_df <- cbind(mi_cod_df$lon, mi_cod_df$lat, mi_cod_df$mi, agi_cod_df$agi) %>% as.data.frame()
colnames(cod_df) <- c("lon", "lat", "mi", "agi")
cod_df$loc <- numFactor(cod_df$lon, cod_df$lat)

mod_cod <- glmmTMB(agi ~ mi + exp(loc + 0 | NULL), data = cod_df, family = "Gamma"); summary(mod_cod)
res_cod <- DHARMa::simulateResiduals(mod_cod)
plot(res_cod)

#plot prediction
pred_df_cod <- data.frame(mi = seq(min(cod_df$mi), max(cod_df$mi), length = 1000))
pred_df_cod$pred_agi <- predict(mod_cod, type = "response", newdata = pred_df_cod, re.form = NA)

ggplot() + 
    geom_point(aes(x = values(mi_cod), y = values(agi_cod)), color = "cornflowerblue", size = 2, alpha = 0.8) + 
    geom_line(data = pred_df_cod, aes(x = mi, y = pred_agi), color = "black", linewidth = 1.3) + 
    theme_custom()

```

## Black sea bass

```{r}
#| warning: false
#| message: false
#| label: mi agi bass
#| echo: false
#| out-width: 100%
#| results: hide

agi_bas <- AGI(sp_name = "Black sea bass", enviro = "bottom")
agi_crit_bas <- get_crit(agi_bas, enviro = "bottom")
mi_bas <- MI(sp_name = "Black sea bass", enviro = "bottom", A0 = 4.07E-04, E0 = 0.27, region = "nwa")
mi_crit_bas <- raster::clamp(mi_bas, upper = 3.26, values = FALSE)
mi_crit_bas <- as.polygons(mi_crit_bas) %>% mutate(lyr = names(mi_bas))

ggplot() +
  geom_spatraster(data = agi_bas) +
  geom_spatvector(data = agi_crit_bas, color = "black", fill = NA, linewidth = 1) +
  geom_sf(data = land, fill = "grey85", colour = "grey30", linewidth = 0.2) +
  coord_sf(xlim = as.vector(ext(agi_bas))[1:2] + c(-2, 2),
           ylim = as.vector(ext(agi_bas))[3:4] + c(-2, 2),
           expand = FALSE) +
  scale_fill_whitebox_c(palette = "muted", direction = -1) +
  labs(x = NULL, y = NULL, fill = "AGI") +
  tidyquant::theme_tq() + 
  facet_wrap(~factor(lyr, levels = names(agi_bas)), labeller = label_wrap_gen(width = 25)) +
  theme_custom()

ggplot() +
  geom_spatraster(data = mi_bas) +
  geom_spatvector(data = mi_crit_bas, color = "black", fill = NA, linewidth = 1) +
  geom_sf(data = land, fill = "grey85", colour = "grey30", linewidth = 0.2) +
  coord_sf(xlim = as.vector(ext(mi_bas))[1:2] + c(-2, 2),
           ylim = as.vector(ext(mi_bas))[3:4] + c(-2, 2),
           expand = FALSE) +
  scale_fill_whitebox_c(palette = "muted", direction = -1) +
  labs(x = NULL, y = NULL, fill = "MI") +
  tidyquant::theme_tq() + 
  facet_wrap(~factor(lyr, levels = names(mi_bas)), labeller = label_wrap_gen(width = 25)) +
  theme_custom()


#run glm to see rship between indices
agi_bas_df <- as.data.frame(agi_bas, xy = TRUE)
colnames(agi_bas_df) <- c("lon", "lat", "agi")
mi_bas_df <- as.data.frame(mi_bas, xy = TRUE)
colnames(mi_bas_df) <- c("lon", "lat", "mi")

bas_df <- cbind(mi_bas_df$lon, mi_bas_df$lat, mi_bas_df$mi, agi_bas_df$agi) %>% as.data.frame()
colnames(bas_df) <- c("lon", "lat", "mi", "agi")
bas_df$loc <- numFactor(bas_df$lon, bas_df$lat)

mod_bas <- glmmTMB(agi ~ mi + exp(loc + 0 | NULL), data = bas_df, family = "Gamma"); summary(mod_bas)
res_bas <- DHARMa::simulateResiduals(mod_bas)
plot(res_bas)

#plot prediction
pred_df_bas <- data.frame(mi = seq(min(bas_df$mi), max(bas_df$mi), length = 1000))
pred_df_bas$pred_agi <- predict(mod_bas, type = "response", newdata = pred_df_bas, re.form = NA)

ggplot() + 
    geom_point(aes(x = values(mi_bas), y = values(agi_bas)), color = "cornflowerblue", size = 2, alpha = 0.8) + 
    geom_line(data = pred_df_bas, aes(x = mi, y = pred_agi), color = "black", linewidth = 1.3) + 
    theme_custom()
```
